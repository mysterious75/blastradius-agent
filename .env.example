# ── LLM Providers (add any one or more) ─────────────────────────
# BlastRadius auto-selects the best available provider
# Priority: opencode_zen > deepseek > openai > anthropic > others
# Any model ID a provider accepts works — unknown models are passed through.
# See: python -m blastradius.providers list | test | set

OPENCODE_API_KEY=        # OpenCode Zen/Go (recommended — free tier)
DEEPSEEK_API_KEY=        # DeepSeek (cheap, great code reasoning)
OPENAI_API_KEY=          # OpenAI GPT-4o / GPT-5.4
ANTHROPIC_API_KEY=       # Anthropic Claude
QWEN_API_KEY=            # Alibaba Qwen (DashScope)
KIMI_API_KEY=            # Moonshot Kimi
GROQ_API_KEY=            # Groq (fastest inference)
TOGETHER_API_KEY=        # Together AI
MISTRAL_API_KEY=         # Mistral
GOOGLE_API_KEY=          # Google Gemini
XAI_API_KEY=             # xAI Grok
OPENROUTER_API_KEY=      # OpenRouter (access 200+ models)
SHODAN_API_KEY=          # Shodan (recon dorking)

# Local OpenAI-compatible servers (no key needed; auto-detected at localhost)
#OLLAMA_BASE_URL=http://localhost:11434/v1
#LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Override auto-selection:
BLASTRADIUS_PROVIDER=    # e.g. deepseek
BLASTRADIUS_MODEL=       # e.g. deepseek-chat (any model ID your provider accepts)

# ── Plugins (all optional — unconfigured plugins are no-ops) ────────────────
JIRA_URL=https://yourcompany.atlassian.net
JIRA_TOKEN=
JIRA_PROJECT=SEC
LINEAR_API_KEY=
#CSV_EXPORT_DIR=          # where the csv_export plugin writes findings.csv

# ── Notifications (all optional — unconfigured channels are skipped) ────────
SLACK_WEBHOOK_URL=       # Slack incoming webhook
DISCORD_WEBHOOK_URL=     # Discord webhook
TELEGRAM_BOT_TOKEN=      # Telegram bot token
TELEGRAM_CHAT_ID=        # Telegram chat id
SMTP_HOST=               # e.g. smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=            # recipient for email alerts
BLASTRADIUS_ISSUES_REPO= # auto-file findings as issues: username/repo

# CAI agent model (defaults to the auto-selected provider model)
CAI_MODEL=

# CAI (research mode — no license needed)
CAI_LICENSE_OFF=1

# GitHub App (Phase 5)
GITHUB_APP_ID=123456
GITHUB_TOKEN=ghp_your-token
GITHUB_WEBHOOK_SECRET=whsec_...

# Database (Phase 5)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# Prometheus scanners
# Absolute path to the prometheus repo root (the directory containing src/).
# Default: ../prometheus relative to this project.
#PROMETHEUS_ROOT=C:\path\to\prometheus

# Optional: pass-through auth token if prometheus enforces one (AUTH_TOKEN)
#AUTH_TOKEN=

# ── Servers & security ───────────────────────────────────────────────────────
# REST API auth — when set, every /api/v1 route requires `Authorization: Bearer <key>`
BLASTRADIUS_API_KEY=
# Dashboard token — when set, POST /scan requires `Authorization: Bearer <token>`
DASHBOARD_TOKEN=
# Server bind hosts — default is loopback; keep it that way unless you are
# behind a reverse proxy (webhook, REST API and dashboard all read these).
#BLASTRADIUS_HOST=127.0.0.1
#DASHBOARD_HOST=127.0.0.1
#DASHBOARD_PORT=8080
# Unsandboxed PoC execution (local subprocess) when no Docker daemon is
# available. OFF by default (fail-closed). Only enable in trusted dev/CI envs.
#BLASTRADIUS_ALLOW_UNSANDBOXED=1
# Reuse scan results across runs (sqlite TTL cache)
#BLASTRADIUS_SCAN_CACHE=1

# Sandbox (Phase 2+)
SANDBOX_TIMEOUT=10
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_ENABLE_NETWORK=false
